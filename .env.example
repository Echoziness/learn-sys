# LLM Provider（任何 OpenAI 兼容接口）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# 各 Agent 独立模型（可选，未设置则统一使用 LLM_MODEL）
# DIAGNOSE_MODEL=
# GENERATE_MODEL=
# REVIEW_MODEL=

# 厂商私有请求字段（可选，JSON 单行；默认不发送任何私有字段）
# 注意：deepseek-v4-flash/pro 思考模式默认开启——先推理后输出，延迟大增；
# 且官方不建议"思考 + JSON 模式"同开（response_format=json_object），
# 本系统所有 LLM 调用都是 JSON 输出，务必显式关闭思考：
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# 本地路径
DATABASE_PATH=data/knowledge.db
BGE_MODEL_PATH=data/bge-m3

# 评测环境变量（可选）
EVAL_BASE_URL=https://api.deepseek.com
EVAL_API_KEY=sk-your-key-here
EVAL_MODEL=deepseek-v4-flash
